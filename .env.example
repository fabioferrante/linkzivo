# ===================================================
# LINKZIVO SAAS - ENVIRONMENT CONFIGURATION
# ===================================================

# Ambientes: development | test | production
NODE_ENV=development
PORT=3000

# URLs da Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SHORT_DOMAIN="lnkz.local:3000"

# Banco de Dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkzivo_dev?schema=public"

# Cache e Filas (Redis / In-memory fallback)
REDIS_URL="redis://localhost:6379"

# Autenticação e Segurança (Sessões & JWT)
AUTH_SECRET="chave-super-secreta-com-pelo-menos-32-caracteres-gerada-aleatoriamente"
NEXTAUTH_URL="http://localhost:3000"

# Google OpenID Connect (OAuth 2.0)
# Obtenha em: https://console.cloud.google.com/apis/credentials
# Callback Dev: http://localhost:3000/api/auth/google/callback
# Callback Prod: https://linkzivo-production.up.railway.app/api/auth/google/callback
GOOGLE_CLIENT_ID="seu-cliente-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-seu-segredo-aqui"

# Billing & Pagamentos (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Planos e Preços Stripe (Price IDs)
STRIPE_PRICE_CREATOR_MONTHLY="price_..."
STRIPE_PRICE_CREATOR_YEARLY="price_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
STRIPE_PRICE_AGENCY_MONTHLY="price_..."
STRIPE_PRICE_AGENCY_YEARLY="price_..."

# Configurações de Rate Limiting
RATE_LIMIT_ANONYMOUS_PER_MIN=15
RATE_LIMIT_AUTHENTICATED_PER_MIN=120

# Segurança e DNS (SSRF Protection)
ENFORCE_SSRF_PROTECTION=true
